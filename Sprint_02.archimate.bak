  <folder name="Technology &amp; Physical" id="id-d07b1cd7a60b42c69e4f0b6ef93451f3" type="technology"/>
  <folder name="Motivation" id="id-ecb08fbf885149d59904300da665e8d7" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Eurofarma" id="id-23669efb13be45d1a482c836dfacfc0a"/>
    <element xsi:type="archimate:Driver" name="Integração de canais digitais, nutrizes e bancos de leite humano" id="id-4d61a187429c419dbcf1b229c8d5163b"/>
    <element xsi:type="archimate:Principle" name="Facilitação do acesso à informação sobre doações e o projeto Lactare" id="id-8558b7055fd84921826282e4fdefa2eb"/>
    <element xsi:type="archimate:Principle" name="Conexão entre nutrizes e banco de leite ou ponto de coleta" id="id-d22d3e00fadd4e26aebf6e5213277fdb"/>
    <element xsi:type="archimate:Principle" name="Criação de dashboards com KPIs" id="id-f276499c1d6e4179903cc49af673c6e9"/>
    <element xsi:type="archimate:Principle" name="Comunicação ativa com nutrizes ativas" id="id-522cf4de4d624006831fdebb52ef8c6c"/>
    <element xsi:type="archimate:Goal" name="Gerar consultas, relatórios, dashboards de acompanhamento de desempenho da solução" id="id-dbe22ab5996148018271e66c2977b082"/>
    <element xsi:type="archimate:Assessment" name="Usar solução de BI de mercado" id="id-557c3f6d2f784a1e97e090d945e0e330"/>
    <element xsi:type="archimate:Requirement" name="Coletar e guardar a resposta da pesquisa" id="id-af7699f11a1542c880e25e510ec9731d"/>
    <element xsi:type="archimate:Requirement" name="Disponibilizar dados transacionais da solução em um banco de dado Data Mart/DW" id="id-57256ad018ff411aac8de7e7ec0be460"/>
    <element xsi:type="archimate:Constraint" name="Construir uma aplicação ETL (Extração, Transformação e Carga) para ler as bases de dados transacionais da solução e alimentar um banco de dados de consulta (DW/datamart)" id="id-2dec357e9d1b4f4fbb2e069c5937d350"/>
    <element xsi:type="archimate:Goal" name="Comunicação com o usuário para resolver suas dúvidas" id="id-a082510b624b427cba05c9549f7c8179"/>
    <element xsi:type="archimate:Requirement" name="Disparar perguntas do usuário" id="id-18bf8ed79c0e422c80edc8044fd2d9cf"/>
    <element xsi:type="archimate:Constraint" name="A mensagem deve conter um texto padrão solicitando as informações base do usuário. " id="id-dd1ebb6c70974a5f9ef3817a8dc1acae"/>
    <element xsi:type="archimate:Requirement" name="Coletar e guardar a resposta das perguntas" id="id-f63e12a9267a409cb89d550def0ef4e5"/>
    <element xsi:type="archimate:Constraint" name="Devem ser coletadas as respostas e guardados os seguintes dados: nome do usuário, região, se é ou não nutriz. Esses dados serão inserido no banco de dados transacional do suporte para uso em consultas." id="id-6440b90ff4a5458d89e7872e0823c137"/>
    <element xsi:type="archimate:Requirement" name="Listar opções de perguntas para o usuário " id="id-57b3c5f91e5145f3b5bf045fa9ad17d6"/>
    <element xsi:type="archimate:Constraint" name="Disparar mensagem contendo possíveis perguntass que o usuário possa ter, de acordo com a informação se é nutriz ou não." id="id-9bf03ebd1370457ca0fb8e249f2f8ef7"/>
    <element xsi:type="archimate:Assessment" name="Usar chatbot de desenvolvimento próprio via WhatsApp" id="id-7105b210f6924e55973228501ea71084"/>
    <element xsi:type="archimate:Requirement" name="Responder as perguntas selecionadas pelo usuário" id="id-f43f5ff3a3ef455095fdf20d85459fae"/>
    <element xsi:type="archimate:Constraint" name="As respostas devem ser esclarecedoras. Caso não seja possível esclarecer, direcionar para o site da Lactare" id="id-b43cffabb5cf4b8ba692a2c98fbb5d14"/>
    <element xsi:type="archimate:Goal" name="Notificar o usuário de tempos e tempos" id="id-73e0a69ccb8243998317bcdf59eb7b7e"/>
    <element xsi:type="archimate:Requirement" name="Enviar notificações de checkup ao usuário" id="id-409487f3787f410bbaca5d6f5b96be3e"/>
    <element xsi:type="archimate:Outcome" name="Tornar o projeto Lactare mais familiar a nutrizes" id="id-7be779377f3248a1b684cb240e35a98d"/>
    <element xsi:type="archimate:Constraint" name="As notfcações devem estreitar a relação com o usuário e relembrar " id="id-04d5ec66aa594cada1dfda6faab256fe"/>
    <element xsi:type="archimate:Outcome" name="Garantir que o usuário mantenha-se engajado com o projeto" id="id-82d63b2938be45ac8348cf0d60325439"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-33064080538a4f01b4dab8ae02693bbf"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-8aab27f9b6504ca3a437af71bb01a3a7"/>
  </folder>
